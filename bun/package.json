{
  "name": "@flickfyi/tsgo",
  "version": "0.1.0",
  "description": "Blazing fast TypeScript type checker powered by TypeScript-Go, accessible via Bun FFI",
  "keywords": [
    "typescript",
    "type-checker",
    "typecheck",
    "ffi",
    "bun",
    "go",
    "fast",
    "jsx",
    "react"
  ],
  "author": "Flick",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/typescript-go"
  },
  "homepage": "https://github.com/anthropics/typescript-go#readme",
  "bugs": {
    "url": "https://github.com/anthropics/typescript-go/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "build:types": "bun x tsc --declaration --emitDeclarationOnly --outDir dist src/index.ts",
    "build:native": "cd .. && go build -buildmode=c-shared -o bun/libtsgo.so ./bun/cgo.go",
    "prepublishOnly": "bun run build && bun run build:types",
    "pretest": "mkdir -p node_modules/@mini node_modules/react node_modules/@types/react && cp -r test/fixtures/@mini/* node_modules/@mini/ && cp -r test/fixtures/react/* node_modules/react/ && cp -r test/fixtures/@types/react/* node_modules/@types/react/",
    "test": "bun test",
    "clean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
